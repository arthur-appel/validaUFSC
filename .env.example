# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=valida
POSTGRES_PASSWORD=valida
POSTGRES_DB=valida_ufsc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL usada pela aplicação (psycopg async). Dentro do Compose, host = "db".
DATABASE_URL=postgresql+psycopg://valida:valida@db:5432/valida_ufsc

# ── Ollama (embeddings locais) ───────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── Motor de equivalência (critério oficial UFSC) ────────────
# Limiares configuráveis por colegiado (default 0.75 = regra dos 75%).
LIMIAR_CONTEUDO=0.75
LIMIAR_CARGA_HORARIA=0.75
# Corte da faixa "boa chance" (similaridade de ementa). CALIBRADO com os dados:
# equivalências oficiais da UFSC ficam acima de ~0.70; 99% dos pares aleatórios
# ficam abaixo de 0.67 (piso do ruído). Abaixar = rede mais larga (mais recall).
LIMIAR_BOA_CHANCE=0.75

# ── Scraper ──────────────────────────────────────────────────
CAGR_TREE_URL=https://cagr.sistemas.ufsc.br/arvore.xhtml?treeid=30
CAGR_CAMPUS=Florianópolis
SCRAPER_DELAY_MS=1500

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
