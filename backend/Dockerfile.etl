# Imagem do job de ETL: inclui Playwright + navegador Chromium para raspar o CAGR (JSF/AJAX).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY valida_ufsc ./valida_ufsc
COPY alembic.ini ./
COPY alembic ./alembic
COPY scripts ./scripts

RUN pip install --upgrade pip && pip install -e ".[etl]"

# Instala o Chromium e suas dependências de sistema para o Playwright.
RUN playwright install --with-deps chromium

CMD ["python", "-m", "valida_ufsc.etl.pipeline"]
